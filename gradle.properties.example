org.gradle.jvmargs=-Xmx2048m -Dfile.encoding=UTF-8
android.useAndroidX=true
kotlin.code.style=official
android.nonTransitiveRClass=true
org.gradle.daemon=false
systemProp.gradle.internal.publish.source.jar=false

# release 签名（密钥文件 release.keystore 放在项目根目录，不入库）
# 复制本文件为 gradle.properties 并填入你自己的签名信息：
# RELEASE_STORE_PASSWORD=你的密码
# RELEASE_KEY_ALIAS=你的别名
# RELEASE_KEY_PASSWORD=你的密码
