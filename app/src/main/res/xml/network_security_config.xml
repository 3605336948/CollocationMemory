<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全策略。

  Android 9（API 28）以上默认**禁止明文 HTTP**，所有网络请求必须走 HTTPS。
  更新服务本来就该用 HTTPS（Gitee / GitHub 都是），所以默认全禁明文是对的。

  这里额外放行两个「本机回环地址」，只为**开发时自测更新流程**用：
  - 10.0.2.2  ：Android 模拟器里访问宿主机 localhost 的固定地址
  - localhost / 127.0.0.1 ：真机上通过 `adb reverse tcp:8000 tcp:8000` 转发时用

  这两个地址在用户手机上不可能被外部劫持（就是本机自己），
  且不接受来自任何外部主机的明文连接，所以留着没有安全风险。
  详见 tools/update/README.md 的「本地自测」一节。
-->
<network-security-config>
    <!-- 正式环境：一律 HTTPS -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- 仅本地调试地址允许明文 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
