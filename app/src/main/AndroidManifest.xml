<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================
         应用内更新所需权限
         ============================================================ -->

    <!-- 拉版本清单、下载词库 JSON、下载更新包 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      应用内安装 APK 的必需声明（Android 8.0+）。

      注意：声明了**不等于**能装。用户还必须去
      「设置 → 应用 → 搭配记忆 → 安装未知应用」里手动打开开关，
      而且最后一定会弹系统的安装确认页。
      这是 Android 的硬性安全限制，任何第三方 App 都绕不过。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Android 11+ 的包可见性：声明后才能在「帮助与反馈」里判断/跳转 QQ 和邮件应用。
      不加这段，resolveActivity 会误判成没有应用能处理，导致点了没反应。
    -->
    <queries>
        <package android:name="com.tencent.mobileqq" />
        <package android:name="com.tencent.mobileqqi" />
        <package android:name="com.tencent.tim" />
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mqqwpa" />
        </intent>
    </queries>

    <application
        android:name=".CollocationMemoryApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CollocationMemory"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CollocationMemory">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 分享「学习战绩」图片：把 cache/share 下的 PNG 以 content:// 形式交给其它应用 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
